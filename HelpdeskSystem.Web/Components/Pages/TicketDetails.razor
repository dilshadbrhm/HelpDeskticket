@page "/ticket/{TicketId:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using HelpdeskSystem.Infrastructure.Identity
@using HelpdeskSystem.Application.Interfaces
@using HelpdeskSystem.Domain.Entities
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITicketRepository TicketRepository
@inject ITicketCommentRepository CommentRepository
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Tiket Detalları</PageTitle>

@if (ticket == null)
{
    <p>Yüklənir...</p>
}
else
{
    <h3>@ticket.Title</h3>

    <div class="card mb-4 p-3">
        <p><strong>Təsvir:</strong> @ticket.Description</p>
        <p><strong>Kateqoriya:</strong> @ticket.Category?.Name</p>
        <p><strong>Prioritet:</strong> @ticket.Priority</p>
        <p><strong>Status:</strong> @ticket.Status</p>
        <p><strong>Yaradılma tarixi:</strong> @ticket.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>
    </div>

    <h5>Şərhlər</h5>

    @if (comments == null || !comments.Any())
    {
        <p>Hələ şərh yoxdur.</p>
    }
    else
    {
        <div class="mb-4">
            @foreach (var comment in comments)
            {
                <div class="card mb-2 p-2">
                    <small class="text-muted">
                        @GetUserName(comment.AuthorUserId) — @comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </small>
                    <p class="mb-0">@comment.Message</p>
                </div>
            }
        </div>
    }

    <EditForm Model="commentModel" OnValidSubmit="HandleAddComment" FormName="CommentForm">
        <div class="mb-3">
            <InputTextArea @bind-Value="commentModel.Message" class="form-control" rows="3" placeholder="Şərh yaz..." />
        </div>
        <button type="submit" class="btn btn-primary">Şərh Əlavə Et</button>
    </EditForm>
}

@code {
    [Parameter]
    public int TicketId { get; set; }

    private Ticket? ticket;
    private List<TicketComment>? comments;
    private CommentModel commentModel = new();
    private string? currentUserId;
    private Dictionary<string, string> userNames = new();

    public class CommentModel
    {
        public string Message { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        currentUserId = UserManager.GetUserId(authState.User);

        await LoadData();
    }

    private async Task LoadData()
    {
        ticket = await TicketRepository.GetByIdAsync(TicketId);
        comments = await CommentRepository.GetByTicketIdAsync(TicketId);

        if (comments != null)
        {
            foreach (var comment in comments)
            {
                if (!userNames.ContainsKey(comment.AuthorUserId))
                {
                    var user = await UserManager.FindByIdAsync(comment.AuthorUserId);
                    if (user != null)
                    {
                        userNames[comment.AuthorUserId] = user.FullName;
                    }
                }
            }
        }
    }

    private string GetUserName(string userId)
    {
        return userNames.TryGetValue(userId, out var name) ? name : userId;
    }

    private async Task HandleAddComment()
    {
        if (string.IsNullOrWhiteSpace(commentModel.Message) || currentUserId == null)
            return;

        var comment = new TicketComment
        {
            TicketId = TicketId,
            AuthorUserId = currentUserId,
            Message = commentModel.Message,
            CreatedAt = DateTime.Now
        };

        await CommentRepository.AddAsync(comment);
        commentModel = new();
        await LoadData();
    }
}